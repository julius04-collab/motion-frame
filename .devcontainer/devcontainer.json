{
  "name": "motionframe",
  "image": "mcr.microsoft.com/playwright:v1.64.0-jammy",
  "containerEnv": { "HOST": "0.0.0.0", "PORT": "4173", "BROWSER_CHANNEL": "none", "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1" },
  "postCreateCommand": "npm ci",
  "postStartCommand": "nohup npm start > /tmp/motionframe.log 2>&1 &",
  "forwardPorts": [4173],
  "portsAttributes": { "4173": { "label": "motionframe", "onAutoForward": "openBrowser" } }
}
